{
  "name": "zitadel-cli",
  "private": true,
  "type": "module",
  "bin": {
    "zitadel": "./dist/cli.js"
  },
  "scripts": {
    "cli": "tsx src/cli/index.ts",
    "cli:build": "tsup",
    "web": "vite",
    "web:build": "vite build",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "build:binary": "bun build --compile src/cli/index.ts --outfile dist/zitadel",
    "mcp": "tsx src/mcp/index.ts",
    "mcp:build": "tsup src/mcp/index.ts --out-dir dist",
    "build:mcp:binary": "bun build --compile src/mcp/index.ts --outfile dist/zitadel-mcp"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-scroll-area": "^1.2.13",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.16",
    "@tailwindcss/vite": "^4.3.2",
    "@zitadel/client": "^1.3.1",
    "@zitadel/proto": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "cli-table3": "^0.6.5",
    "clsx": "^2.1.1",
    "commander": "^13.1.0",
    "jose": "^5.9.6",
    "lucide-react": "^1.23.0",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1",
    "smol-toml": "^1.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
